# ============================================================================
# AI Founder Hub — environment variables
# ============================================================================

# ---- FRONTEND (Vite, must be prefixed VITE_, safe to expose) ----------------
# From your Supabase project: Settings > API. Leave BLANK to run the site in
# demo mode (forms simulate success, booking shows a "coming soon" note).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---- BACKEND (Supabase Edge Function secrets) -------------------------------
# Set these with: supabase secrets set KEY=value   (NEVER commit real values)
# Supabase auto-injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in functions,
# but set them explicitly if running locally.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Ziina (https://docs.ziina.com). Use a TEST key while building.
ZIINA_API_KEY=""
ZIINA_API_BASE="https://api-v2.ziina.com/api"   # confirm in your Ziina dashboard
ZIINA_TEST_MODE="true"                          # "false" for live charges
ZIINA_WEBHOOK_SECRET=""                         # shared secret you also set in Ziina

# Resend (https://resend.com) for transactional email
RESEND_API_KEY=""
EMAIL_FROM="AI Founder Hub <hello@aifounderhub.com>"   # must be a verified domain
BOOKINGS_NOTIFY_EMAIL="bookings@aifounderhub.com"      # YOUR inbox for booking + payment alerts

# Site + product config
SITE_URL="https://aifounderhub.com"             # used for payment redirect URLs
ALLOWED_ORIGIN="*"                              # tighten to your domain in production
BOOTCAMP_PRICE_FILS="91500"                     # ~249 USD in AED fils; set your exact price
MEMBERSHIP_PRICE_FILS="18350"                   # ~49.99 USD in AED fils; set your exact price
